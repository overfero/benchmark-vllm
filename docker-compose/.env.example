# Copy to .env and fill in real values before `docker compose up`.
# Generate random secrets with: openssl rand -hex 32  (or -hex 16 for API keys)

# LiteLLM
LITELLM_MASTER_KEY=sk-vllm-CHANGEME
# Must match the --api-key already used when launching vLLM on Zrok7/8
# (service_vllm.sh --api-key ...) - reuse the same value, don't regenerate.
VLLM_API_KEY=CHANGEME
# Must match the --api-key used when launching Laya on Zrok9
# (service_laya.sh --api-key ...) - the content-safety classifier, see
# litellm/safety_guardrail.py. No longer a separate 8B Llama Guard model -
# Laya is a 421M non-autoregressive classifier.
LAYA_API_KEY=CHANGEME

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
# Created via Keycloak's Admin REST API after `docker compose up`, same
# steps already used for the K8s version: create realm "chat-ui", client
# "chat-dashboard" (redirectUris including http://localhost:4180/oauth2/callback),
# then fetch its secret from /admin/realms/chat-ui/clients/<uuid>/client-secret
CHAT_DASHBOARD_CLIENT_SECRET=CHANGEME
# Generate: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_PROXY_COOKIE_SECRET=CHANGEME

# Langfuse - these 2 keys are made up by you (not fetched from anywhere),
# then used BOTH as litellm's LANGFUSE_PUBLIC_KEY/SECRET_KEY above AND as
# langfuse-web's LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY below - they
# must be identical in both places, that's what makes headless init "just work".
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME
LANGFUSE_ADMIN_PASSWORD=CHANGEME

# OpenBao
OPENBAO_ROOT_TOKEN=CHANGEME

# Optional - safe defaults already set in docker-compose.yml, override only if needed
# LITELLM_DB_PASSWORD=
# KEYCLOAK_DB_PASSWORD=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_USER=
# LANGFUSE_MINIO_PASSWORD=
